ENV=dev

# debug | info | warn | error; format text | json
LOG_LEVEL=debug
LOG_FORMAT=text

SERVER_HOST=127.0.0.1
SERVER_PORT=8080
# Comma-separated CIDRs of reverse proxies whose X-Forwarded-For is trusted; empty = use the TCP peer address
SERVER_TRUSTED_PROXIES=

MONGO_URI=mongodb://root:root@localhost:27017
MONGO_DATABASE=goose

REDIS_URL=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

APP_NAME=Goose

JWT_SECRET=change-me
JWT_TTL=720h

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGINS=http://localhost:3000

TRUECALLER_CLIENT_ID=
TRUECALLER_BASE_URL=https://oauth-account-noneu.truecaller.com

# Defaults point at Mailpit from docker/docker-compose.yml (inbox at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Goose <no-reply@goose.local>

# 32 random bytes, base64: openssl rand -base64 32
SECURITY_ENCRYPTION_KEY=

RATE_LIMIT_GLOBAL_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10

MOBILE_ANDROID_PACKAGE=
# Comma-separated SHA-256 signing cert fingerprints (AB:CD:...)
MOBILE_ANDROID_CERT_FINGERPRINTS=
# Comma-separated TEAMID.bundle.id
MOBILE_IOS_APP_IDS=

# Shared HMAC secret with the OAuth service (openssl rand -hex 32); empty disables the webhook
WEBHOOKS_OAUTH_SECRET=
