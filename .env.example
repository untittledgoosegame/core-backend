ENV=dev

# debug | info | warn | error; format text | json
LOG_LEVEL=debug
LOG_FORMAT=text

SERVER_HOST=127.0.0.1
SERVER_PORT=8080
# Comma-separated CIDRs of reverse proxies whose X-Forwarded-For is trusted; empty = use the TCP peer address
SERVER_TRUSTED_PROXIES=

MONGO_URI=mongodb://root:root@localhost:27017
MONGO_DATABASE=goose

REDIS_URL=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Image uploads: Cloudflare R2 (any S3-compatible store works).
# STORAGE_ENDPOINT is the S3 API used for uploads: <account_id>.r2.cloudflarestorage.com
# STORAGE_PUBLIC_URL is where images are served from: your R2 custom domain or r2.dev URL.
# The defaults below point at the local s3mock from docker/compose.yml. An empty endpoint disables uploads.
STORAGE_ENDPOINT=localhost:9090
STORAGE_REGION=auto
STORAGE_BUCKET=goose-images
STORAGE_ACCESS_KEY=local
STORAGE_SECRET_KEY=local
STORAGE_USE_SSL=false
STORAGE_PUBLIC_URL=http://localhost:9090/goose-images

APP_NAME=Goose

JWT_SECRET=change-me
JWT_TTL=720h

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGINS=http://localhost:3000

TRUECALLER_CLIENT_ID=
TRUECALLER_BASE_URL=https://oauth-account-noneu.truecaller.com

# Defaults point at Mailpit from docker/docker-compose.yml (inbox at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Goose <no-reply@goose.local>

# 32 random bytes, base64: openssl rand -base64 32
SECURITY_ENCRYPTION_KEY=

RATE_LIMIT_GLOBAL_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10

MOBILE_ANDROID_PACKAGE=
# Comma-separated SHA-256 signing cert fingerprints (AB:CD:...)
MOBILE_ANDROID_CERT_FINGERPRINTS=
# Comma-separated TEAMID.bundle.id
MOBILE_IOS_APP_IDS=

# OAuth service that connects third-party accounts (YouTube, Spotify, Steam, ...).
# The secret (openssl rand -hex 32) signs connect links, revoke calls and incoming webhooks.
# Empty values disable connecting, disconnecting and the webhook.
OAUTH_SERVICE_BASE_URL=
OAUTH_SERVICE_SECRET=
